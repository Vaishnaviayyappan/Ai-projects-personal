DATABASE_URL=sqlite:///./data/app.db
CHROMA_PERSIST_DIR=./data/chroma

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

OLLAMA_BASE_URL=http://localhost:11434
# llama3.2 (3B) responds in ~5-15s per call on CPU-only machines. Swap to llama3.1 (8B) or a
# cloud model for better reasoning quality if you have a GPU or don't mind higher latency.
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# Default open-source avatar video (seconds per clip, visibly lower quality). See
# backend/wav2lip/ for setup. Set to false to disable even if the environment is set up.
ENABLE_WAV2LIP=true

# Highest-quality open-source avatar video: real head motion + GFPGAN sharpening, via a local
# SadTalker install. OFF by default -- it takes 10-25+ minutes PER REPLY on a CPU-only machine,
# which makes it impractical for live/interactive use. Only turn this on if you specifically
# want to see the best open-source quality and don't mind the wait. See backend/sadtalker/ for
# setup, and README.md's "Avatar video" section for the full tradeoff writeup.
ENABLE_SADTALKER=false

CORS_ORIGINS=["http://localhost:3000"]
